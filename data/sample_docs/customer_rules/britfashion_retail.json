{
  "customer_name": "BritFashion Retail Group Plc",
  "applies_to": "shipment_5",
  "rules": {
    "consignee_name": {
      "match_type": "exact",
      "expected": "BritFashion Retail Group Plc",
      "case_sensitive": true
    },
    "hs_code_format": {
      "match_type": "format",
      "pattern": "####.##.##",
      "digits": 8
