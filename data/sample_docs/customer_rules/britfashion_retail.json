    "hs_code_accuracy": {
      "match_type": "product_match",
      "note": "HS code must match actual fabric composition"
    },
    "incoterm_consistency": {
      "match_type": "cross_document_consistent",
      "field": "incoterm"
    },
    "weight_cross_doc": {
      "match_type": "cross_document_consistent",
      "tolerance_pct": 1.0
    },
    "gsp_origin": {
      "match_type": "exact",
      "expected": "Bangladesh",
      "note": "Required for GSP duty preference"
    }
  }
}